<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ucapan Spesial</title>
<style>
  body {
    margin: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #1e3c72, #2a5298);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    text-align: center;
    overflow: hidden;
  }
  .card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    max-width: 350px;
    width: 85%;
    transition: transform 0.3s ease;
  }
  img {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid white;
    margin-bottom: 15px;
  }
  h1 {
    font-size: 22px;
    margin: 10px 0;
  }
  p {
    font-size: 15px;
    line-height: 1.5;
    margin-bottom: 20px;
  }
  button {
    background: #ff4757;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 25px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
  }
  button:hover {
    background: #ff6b81;
  }
  .hidden {
    display: none;
  }
</style>
</head>
<body>

  <!-- Tampilan Awal (Amplop/Cover) -->
  <div class="card" id="cover">
    <img src="https://placeholder.com" alt="Foto Profil" id="fotoCover">
    <h1 id="judulCover">Ada Pesan Buat Kamu! 📩</h1>
    <p>Klik tombol di bawah buat buka suratnya.</p>
    <button onclick="bukaSurat()">Buka Surat</button>
  </div>

  <!-- Tampilan Isi Surat -->
  <div class="card hidden" id="isiSurat">
    <img src="https://placeholder.com" alt="Foto Isi" id="fotoIsi">
    <h1 id="judulIsi">Halo Bro! 👋</h1>
    <p id="teksPesan">
      Terima kasih sudah jadi teman yang asik dan selalu ada pas lagi susah maupun senang. Tetap semangat ya! 💙
    </p>
    <button onclick="balasPesan()">💌 Balas Pesan</button>
  </div>

  <!-- Musik Latar (Opsional) -->
  <audio id="musik" loop>
    <source src="https://soundhelix.com" type="audio/mpeg">
  </audio>

<script>
  // === AREA CUSTOM (UBAH DI SINI) ===
  const nomorWhatsApp = "6281234567890"; // Ganti dengan nomor WA kamu (awali dengan 62)
  const teksBalasanWA = "Halo! Makasih ya udah bikin web lucu ini 😂";

  function bukaSurat() {
    document.getElementById('cover').classList.add('hidden');
    document.getElementById('isiSurat').classList.remove('hidden');
    
    // Putar musik otomatis saat surat dibuka
    const audio = document.getElementById('musik');
    audio.play().catch(e => console.log("Audio butuh interaksi user"));
  }

  function balasPesan() {
    const url = `https://wa.me{nomorWhatsApp}?text=${encodeURIComponent(teksBalasanWA)}`;
    window.open(url, '_blank');
  }
</script>

</body>
</html>
